
DATABASE_URL=
REDIS_URL=
LOG_LEVEL=INFO

# development → skip Admin Origin checks (Postman/Swagger).
# production / staging → enforce ADMIN_ALLOWED_ORIGINS.
ENVIRONMENT=development

# Per-process PostgreSQL connection budget. Keep pooling enabled in production.
DISABLE_DB_POOL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

DB_USER = 
DB_PASSWORD = 
DB_HOST = 
DB_PORT = 
DB_NAME = 
DB_SSLMODE = require

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=KampuLynk

# Auto content moderation / blacklist scanner (in-process lifespan cron)
AUTO_MODERATION_ENABLED=true
AUTO_MODERATION_CRON_INTERVAL_SECONDS=120
AUTO_MODERATION_BATCH_SIZE=50

AUTO_INIT_DB=true
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_WEB_API_KEY=

FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","measurementId":""}'

# for jwt
# Web Admin access tokens should be short-lived; RSA signing keys outlive JWT refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=15
ACCESS_TOKEN_TTL_MINUTES=
JWT_SECRET=
JWT_ALGORITHM=

# Web Admin JWT lifetimes (optional; defaults 15 / 10080)
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Web Admin RSA request signing (browser keeps the private key).
# Shared rate limit for signed requests, login, key-register, and forgot-password.
# Window seconds also throttles admin session last_seen writes.
ADMIN_SIGNING_ALGORITHM=RSA-PSS
ADMIN_SIGNING_HASH=SHA-256
ADMIN_SIGNING_KEY_SIZE=2048
ADMIN_SIGNING_TIMESTAMP_TOLERANCE_SECONDS=60
ADMIN_SIGNING_NONCE_TTL_SECONDS=120
ADMIN_SIGNING_PENDING_TTL_SECONDS=600
ADMIN_SIGNING_RATE_LIMIT_REQUESTS=120
ADMIN_SIGNING_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated Origins for signed Web Admin requests.
# Required when ENVIRONMENT=production|staging; ignored in development.
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,https://kampulynk-stage-portal-ponyy.ondigitalocean.app

# for analytics
DEFAULT_DAYS = 
MAX_DAYS = 
DEFAULT_TOP_LIMIT = 
MAX_TOP_LIMIT =

# for comments
DEFAULT_COMMENT_MAX_DEPTH=3

# Post like recognition milestones (JSON array of like counts)
POST_RECOGNITION_MILESTONES=[10]

# for posts
HASHTAG_LIMIT=5

# DigitalOcean Spaces (S3-compatible)
# S3_ENDPOINT must be HTTPS, e.g. https://sfo3.digitaloceanspaces.com
# (http:// is upgraded to https:// automatically). Do not use the CDN host here.
# S3_CDN_ENDPOINT / S3_FILE_ENDPOINT are used to build public post/media, profile, and banner URLs in API responses.
# Data-export downloads use S3_ENDPOINT (origin), not the CDN.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_FILE_ENDPOINT=
S3_CDN_ENDPOINT=

# Export
EXPORT_RETENTION_DAYS=7
EXPORT_SIGNED_URL_EXPIRES_SECONDS=900

# Celery broker (Redis-compatible). Export processing uses the background queue.
CELERY_REDIS_URL=redis://default:kampulynk_redis@localhost:6379
CELERY_REDIS_SSL_ENABLED=false
CELERY_BROKER_DB=1
CELERY_REDBEAT_DB=2
CELERY_WORKER_POOL=prefork
CELERY_WORKER_CONCURRENCY=1

# Enable embedded Beat on only one worker instance.
CELERY_BEAT_ENABLED=false

# Durable-work reconciliation (Celery Beat → kampulynk.reconcile.tick on background)
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=60
RECONCILIATION_BATCH_SIZE=25


# For Invitation
INVITATION_DAILY_LIMIT=50
INVITATION_BLOCK_DAYS=7
INVITATION_CODE_LENGTH=7

# Shared business calendar timezone (IANA) for analytics + invitations.
# Default: Eastern Time (EST/EDT via America/New_York). Used for:
# - Analytics dashboard day boundaries (DAU, registration trends, "today")
# - Invitation daily limits (calendar day)
ANALYTICS_TIMEZONE=America/New_York

# firebase secret

# OTP and Password Reset Token Configurations
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
RESEND_OTP_COOLDOWN_MINUTES=2
OTP_EXPIRE_MINUTES=10
LOGO_URL=

# Stream 
STREAM_API_KEY=
STREAM_SECRET_KEY=



# APN
APNS_PRIVATE_KEY=

APNS_KEY_ID=

APNS_TEAM_ID=

APNS_TOPIC=

# true -> api.sandbox.push.apple.com
# false -> api.push.apple.com
APNS_USE_SANDBOX=false

# Account deletion grace period
ACCOUNT_PURGE_AFTER_DAYS=30

# Account deletion background worker interval
ACCOUNT_DELETION_CRON_INTERVAL_HOURS=24

# Device limit
MAX_ACCOUNTS_PER_DEVICE=3

# When True, reject known disposable/temporary email domains at registration.
IS_DISPOSABLE_EMAIL_ENABLED=False

DD_TRACE_ENABLED=false
DD_LOGS_INJECTION=false

# Learning Spotlight (V2)
LEARNING_SPOTLIGHT_CANDIDATE_LIMIT=30
LEARNING_SPOTLIGHT_BATCH_SIZE=50
LEARNING_SPOTLIGHT_WEIGHT_USER_RELEVANCE=0.40
LEARNING_SPOTLIGHT_WEIGHT_PAPER_QUALITY=0.20
LEARNING_SPOTLIGHT_WEIGHT_RECENCY=0.10
LEARNING_SPOTLIGHT_WEIGHT_CATEGORY=0.30
LEARNING_SPOTLIGHT_WEIGHT_THINKER_AUTHOR=0.70
LEARNING_SPOTLIGHT_WEIGHT_THINKER_RELEVANCE=0.30
# Learning Spotlight cron runs daily at 00:00 UTC.
LEARNING_SPOTLIGHT_CRON_INTERVAL_HOURS=24


# share  token
SHARE_POST_TOKEN=

# Branch.io
BRANCH_KEY=
BRANCH_API_URL=
